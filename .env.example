# DSCE RAG Chatbot Environment Variables

# LLM Provider Configuration
# Option 1: Groq API (Ultra-fast inference via Llama/GPT-OSS models - Recommended)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Google Gemini API (Alternative cloud provider)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Local Ollama (Optional for local testing without API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Host & Port Settings
HOST=0.0.0.0
PORT=8000
